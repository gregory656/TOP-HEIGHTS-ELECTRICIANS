rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Simple role check (expects users/{uid}.role == "admin")
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Public catalog reads
    match /products/{productId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users + per-user cart
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'customer'
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'photoURL', 'role', 'createdAt', 'updatedAt']);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'name', 'email', 'photoURL', 'updatedAt'])
        && request.resource.data.uid == userId;
      allow delete: if false;

      match /cart/{productId} {
        // Per-user isolated cart
        allow read, write: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // Orders
    match /orders/{orderId} {
      // Server quotes prices and verifies all payment/fulfilment writes.
      allow create: if false;

      // Customer can read their own orders; admin can read all.
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();

      allow update: if false;

      allow delete: if false;
    }

    // Payment transactions (audit trail) - backend/admin only
    match /transactions/{transactionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /fulfilmentEvents/{eventId} {
      allow read: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.userId == request.auth.uid);
      allow write: if false;
    }
    match /inventoryMovements/{movementId} { allow read: if isAdmin(); allow write: if false; }
    match /catalogueKeys/{keyId} { allow read, write: if false; }

    // Provider signatures and payment references are server-only.
    match /paymentSessions/{orderId} { allow read, write: if false; }
    match /paymentReferences/{referenceId} { allow read, write: if false; }

    // Courses - public read, admin write
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    // Enrollments - read by owner and admin, write by admin
    match /enrollments/{enrollmentId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // News - public read, admin write
    match /news/{newsId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if false;
    }
  }
}

