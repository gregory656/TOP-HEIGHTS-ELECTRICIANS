# Backend non-secret configuration. Sandbox is the default.
INTASEND_MODE=sandbox
INTASEND_PUBLIC_KEY=
STOREFRONT_ORIGIN=http://127.0.0.1:5174
SITE_INDEXABLE=false
# Store INTASEND_SECRET_KEY and INTASEND_WEBHOOK_CHALLENGE (at least 32 characters)
# in Firebase Secret Manager. For emulators only, use untracked .secret.local.
