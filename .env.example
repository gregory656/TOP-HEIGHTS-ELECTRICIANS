VITE_CHAT_API_URL=http://localhost:3001
VITE_COMMERCE_API_URL=
# Firebase web app configuration from the separate staging project (public identifiers).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Local emulators only. Keep false on any hosted build.
VITE_USE_FIREBASE_EMULATORS=false
# Exact site origin, without a trailing slash. Staging must remain noindex.
VITE_SITE_URL=
VITE_INDEXABLE=false
# Set to cloudinary for the free-hosted staging API, or firebase for Storage.
VITE_IMAGE_UPLOAD_PROVIDER=firebase
VITE_IMAGE_UPLOADS_ENABLED=false
